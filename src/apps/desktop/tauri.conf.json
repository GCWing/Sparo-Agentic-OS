{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sparo OS",
  "identifier": "com.sparo-os.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev:web",
    "devUrl": "http://localhost:5722",
    "beforeBuildCommand": "pnpm run build:web && pnpm run prepare:mobile-web",
    "frontendDist": "../../../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../mobile-web/dist": "mobile-web/dist",
      "resources/worker_host.js": "resources/worker_host.js",
      "icons/tray/tray-idle.png": "icons/tray/tray-idle.png",
      "icons/tray/tray-running.png": "icons/tray/tray-running.png",
      "icons/tray/tray-waiting.png": "icons/tray/tray-waiting.png",
      "icons/tray/tray-error.png": "icons/tray/tray-error.png"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "files": {
          "/usr/share/icons/hicolor/16x16/apps/sparo-os.png": "icons/hicolor/16x16/apps/sparo-os.png",
          "/usr/share/icons/hicolor/32x32/apps/sparo-os.png": "icons/hicolor/32x32/apps/sparo-os.png",
          "/usr/share/icons/hicolor/48x48/apps/sparo-os.png": "icons/hicolor/48x48/apps/sparo-os.png",
          "/usr/share/icons/hicolor/64x64/apps/sparo-os.png": "icons/hicolor/64x64/apps/sparo-os.png",
          "/usr/share/icons/hicolor/96x96/apps/sparo-os.png": "icons/hicolor/96x96/apps/sparo-os.png",
          "/usr/share/icons/hicolor/128x128/apps/sparo-os.png": "icons/hicolor/128x128/apps/sparo-os.png",
          "/usr/share/icons/hicolor/256x256/apps/sparo-os.png": "icons/hicolor/256x256/apps/sparo-os.png",
          "/usr/share/icons/hicolor/512x512/apps/sparo-os.png": "icons/hicolor/512x512/apps/sparo-os.png"
        },
        "postInstallScript": "scripts/post-install-icons.sh"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sparo OS",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "visible": false,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "decorations": true,
        "backgroundColor": "#121214"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": ["'self'", "data:"],
        "img-src": ["'self'", "data:", "blob:", "asset:", "http://asset.localhost", "https://asset.localhost", "tauri:"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "https://ipc.localhost", "ws://localhost:5721", "http://localhost:5722", "http://127.0.0.1:*", "https:"],
        "worker-src": ["'self'", "blob:"],
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    },
    "withGlobalTauri": false
  }
}
