{
  "id": "builtin-remotion-live",
  "name": "Remotion Live",
  "description": "A native Sparo video preview workbench for Remotion projects with app-owned playback, timeline, and export controls.",
  "icon": "Film",
  "category": "creative",
  "tags": [
    "built-in",
    "remotion",
    "video",
    "preview"
  ],
  "version": 15,
  "created_at": 0,
  "updated_at": 0,
  "permissions": {
    "fs": {
      "read": [
        "{appdata}"
      ],
      "write": [
        "{appdata}"
      ]
    },
    "shell": {
      "allow": []
    },
    "net": {
      "allow": [
        "http://127.0.0.1:*",
        "http://localhost:*"
      ]
    },
    "node": {
      "enabled": false
    },
    "ai": {
      "enabled": false
    }
  },
  "permission_rationale": "Remotion Live runs its product UI inside the Live App bundle and calls declared bridge backend actions for project analysis, local Remotion Player preview hosting, optional Studio preview hosting, still generation, and export orchestration. Localhost network access is limited to embedding workspace-owned Remotion preview hosts started by the Remotion runtime bridge.",
  "ai_context": {
    "original_prompt": "A built-in composite Live App named Remotion Live for native video-preview collaboration.",
    "conversation_id": null,
    "iteration_history": []
  },
  "interaction": {
    "mode": "composite",
    "profile": "live-app-workbench",
    "title": {
      "en-US": "Remotion Live",
      "zh-CN": "Remotion Live"
    },
    "chat": {
      "backendId": "remotionAgent",
      "agentAppId": "remotion-video-agent",
      "sessionPolicy": "perEntity",
      "memoryScope": "appInstance",
      "initialPromptKey": "remotion_live_bootstrap",
      "allowUserPrompt": true
    },
    "tabs": [
      {
        "id": "preview",
        "type": "liveAppWorkbenchTab",
        "route": "/preview",
        "title": {
          "en-US": "Preview",
          "zh-CN": "预览"
        },
        "default": true
      }
    ]
  },
  "backends": [
    {
      "id": "remotionRuntime",
      "kind": "bridgeApp",
      "appId": "builtin-remotion-runtime",
      "capabilityId": "sparo.videoEngine",
      "role": "runtime",
      "sessionPolicy": "perEntity",
      "memoryScope": "appInstance",
      "actions": [
        {
          "name": "detectProject"
        },
        {
          "name": "compileProject"
        },
        {
          "name": "getCompositionManifest"
        },
        {
          "name": "getFrameContext"
        },
        {
          "name": "renderPreviewFrame"
        },
        {
          "name": "renderPreviewClip"
        },
        {
          "name": "ensurePlayerPreviewHost"
        },
        {
          "name": "getPlayerPreviewHostStatus"
        },
        {
          "name": "stopPlayerPreviewHost"
        },
        {
          "name": "ensurePreviewServer"
        },
        {
          "name": "getPreviewServerStatus"
        },
        {
          "name": "stopPreviewServer"
        },
        {
          "name": "renderStill"
        },
        {
          "name": "startExport"
        },
        {
          "name": "getExportStatus"
        },
        {
          "name": "cancelExport"
        }
      ]
    },
    {
      "id": "remotionAgent",
      "kind": "agentApp",
      "appId": "remotion-video-agent",
      "role": "assistant",
      "sessionPolicy": "perEntity",
      "memoryScope": "appInstance",
      "actions": [
        {
          "name": "understandVideoProject"
        },
        {
          "name": "reviseVideoComposition"
        },
        {
          "name": "renderReviewArtifact"
        }
      ]
    }
  ],
  "i18n": {
    "locales": {
      "zh-CN": {
        "name": "Remotion Live",
        "description": "一个原生 Sparo 视频预览工作台，用于 Remotion 项目的播放、时间线和导出协作。",
        "tags": [
          "内置",
          "Remotion",
          "视频",
          "预览"
        ]
      },
      "en-US": {
        "name": "Remotion Live",
        "description": "A native Sparo video preview workbench for Remotion projects with app-owned playback, timeline, and export controls.",
        "tags": [
          "built-in",
          "remotion",
          "video",
          "preview"
        ]
      }
    }
  }
}
