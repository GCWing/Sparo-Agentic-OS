      "composition": { "type": "string" },
      "frame": { "type": "integer" },
      "inputProps": { "type": "object" },
      "selection": { "type": "object" },
      "selectedElement": { "type": "object" }
    }
  },
  "runtime": "javascript",
  "entry": "tools/get_frame_context.js",
  "readonly": true,
  "permissions": {},
  "timeoutMs": 30000,
