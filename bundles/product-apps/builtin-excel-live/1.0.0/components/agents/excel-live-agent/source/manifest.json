  "examples": [
    {
      "title": "Point and explain",
      "prompt": "With the current selection as focus, explain its structure, formulas, and anomalies without changing any cells."
    },
    {
      "title": "Design a management table",
      "prompt": "Turn the focused data into a clear management table with a restrained header style, appropriate number formats, readable widths, a frozen header row, totals, and safe formulas. Propose everything together for review."
    },
    {
      "title": "Author a quarterly summary",
      "prompt": "Create a quarterly sales summary sheet with a clear information hierarchy, editable assumptions, summary formulas, percentage formats, totals, and a professional layout, then let me review it on the grid."
    },
    {
      "title": "Engineer robust formulas",
      "prompt": "Read the focused table, add guarded SUMIFS and growth formulas using the real column layout, statically validate the references, and do not claim calculated results unless recalculation is fresh."
    }
  ]
