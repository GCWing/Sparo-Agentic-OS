{
  "name": "propose_patch",
  "description": "Create one revision-bound proposal containing values, formulas, cell styles, semantic style roles, and sheet layout. Nothing is committed until the proposal is accepted on the grid.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "workbookId",
      "expectedRevision",
      "intent"
    ],
    "anyOf": [
      { "required": ["cells"] },
      { "required": ["values"] },
      { "required": ["layout"] },
      { "required": ["operations"] }
    ],
    "properties": {
      "workbookId": {
        "type": "string"
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Exact revision returned by the current focus or workbook metadata. Refresh after every mutation or revision conflict."
      },
      "intent": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "description": "Concise user-facing reason, design intent, and expected outcome."
      },
      "designIntent": {
        "type": "object",
        "additionalProperties": false,
        "description": "Optional creative brief used to keep a multi-part spreadsheet design coherent.",
        "properties": {
          "purpose": { "type": "string", "maxLength": 200 },
          "audience": { "type": "string", "maxLength": 200 },
          "tone": { "type": "string", "maxLength": 120 }
        }
      },
      "sheetId": {
        "type": "string"
      },
      "a1": {
        "type": "string",
        "description": "Anchor for values[][] or a sheet-qualified range hint."
      },
      "cells": {
        "type": "array",
        "description": "Sparse 0-based cell patches. A cell may change content, style, or both; style-only cells intentionally omit value and formula.",
        "maxItems": 5000,
        "items": { "$ref": "#/$defs/cell" }
      },
      "values": {
        "type": "array",
        "description": "Legacy dense values matrix anchored at a1. Strings beginning with = are formulas.",
        "items": {
          "type": "array",
          "items": {}
        }
      },
      "layout": {
        "$ref": "#/$defs/layout"
      },
      "operations": {
        "type": "array",
        "description": "Composable same-sheet authoring operations compiled into one atomic cells+layout proposal. Use root sheetId for clarity. Use this for coherent multi-range designs; use direct cells/values/layout for simple edits.",
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "set_cells",
                "set_values",
                "set_formulas",
                "apply_style",
                "set_layout"
              ]
            },
            "a1": {
              "type": "string",
              "description": "Required for set_values, set_formulas, and apply_style."
            },
            "cells": {
              "type": "array",
              "maxItems": 5000,
              "items": { "$ref": "#/$defs/cell" },
              "description": "Required for set_cells."
            },
            "values": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {}
              },
              "description": "Required for set_values or set_formulas. Formula strings may include or omit the leading = for set_formulas."
            },
            "styleRole": {
              "$ref": "#/$defs/styleRole"
            },
            "style": {
              "$ref": "#/$defs/style"
            },
            "layout": {
              "$ref": "#/$defs/layout"
            }
          }
        }
      }
    },
    "$defs": {
      "styleRole": {
        "type": "string",
        "enum": [
          "title",
          "header",
          "input",
          "output",
          "total",
          "note",
          "warning"
        ],
        "description": "Stable semantic styling. Prefer a role before adding custom overrides."
      },
      "borderSide": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "description": "Border side override, or null to remove that side.",
        "properties": {
          "style": {
            "type": "string",
            "enum": ["thin", "medium", "thick", "dashed", "dotted", "double"]
          },
          "color": {
            "type": "string",
            "description": "Six-digit RGB hex color, with optional leading #."
          }
        }
      },
      "style": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "description": "Cell style override. Null clears the complete cell style and supersedes styleRole. Keep overrides sparse so semantic roles and source fidelity remain stable.",
        "properties": {
          "role": { "$ref": "#/$defs/styleRole" },
          "fill": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "description": "Fill override, or null to remove the fill.",
            "properties": {
              "color": {
                "type": "string",
                "description": "Six-digit RGB hex color, with optional leading #."
              }
            }
          },
          "font": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "description": "Font override, or null to remove custom font properties.",
            "properties": {
              "bold": { "type": ["boolean", "null"] },
              "italic": { "type": ["boolean", "null"] },
              "color": { "type": ["string", "null"] },
              "size": { "type": ["number", "null"], "minimum": 6, "maximum": 72 }
            }
          },
          "border": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "description": "Border override, or null to remove all custom borders.",
            "properties": {
              "top": { "$ref": "#/$defs/borderSide" },
              "right": { "$ref": "#/$defs/borderSide" },
              "bottom": { "$ref": "#/$defs/borderSide" },
              "left": { "$ref": "#/$defs/borderSide" }
            }
          },
          "alignment": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "description": "Alignment override, or null to remove custom alignment.",
            "properties": {
              "horizontal": {
                "type": ["string", "null"],
                "enum": ["left", "center", "right", "general", null]
              },
              "vertical": {
                "type": ["string", "null"],
                "enum": ["top", "center", "bottom", null]
              },
              "wrapText": { "type": ["boolean", "null"] }
            }
          },
          "numberFormat": {
            "type": ["string", "null"],
            "maxLength": 120,
            "description": "Excel-compatible number format such as #,##0.00, 0.0%, or yyyy-mm-dd; null removes it. Formatting does not change the underlying value."
          }
        }
      },
      "cell": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row", "col"],
        "properties": {
          "row": { "type": "integer", "minimum": 0 },
          "col": { "type": "integer", "minimum": 0 },
          "value": {},
          "formula": {
            "type": "string",
            "description": "Formula with or without a leading =."
          },
          "styleRole": { "$ref": "#/$defs/styleRole" },
          "style": { "$ref": "#/$defs/style" }
        }
      },
      "layout": {
        "type": "object",
        "additionalProperties": false,
        "description": "Sheet layout metadata included in the same proposal. Column and row start/end indices are 0-based and inclusive; A1 remains 1-based Excel notation.",
        "properties": {
          "columns": {
            "type": "array",
            "description": "Column layout bands. An explicit empty array clears all custom column-width metadata.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start"],
              "properties": {
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 0 },
                "width": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 255,
                  "description": "Width in Excel character units, never pixels."
                },
                "autoFit": { "type": "boolean" }
              }
            }
          },
          "rows": {
            "type": "array",
            "description": "Row layout bands. An explicit empty array clears all custom row-height metadata.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start"],
              "properties": {
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 0 },
                "height": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 409,
                  "description": "Height in points, never pixels."
                },
                "autoFit": { "type": "boolean" }
              }
            }
          },
          "freezePanes": {
            "type": "object",
            "additionalProperties": false,
            "description": "Frozen row/column counts. Use rows:0 and columns:0 to clear frozen panes.",
            "properties": {
              "rows": { "type": "integer", "minimum": 0 },
              "columns": { "type": "integer", "minimum": 0 }
            }
          },
          "autoFilter": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "a1": { "type": "string" }
            },
            "description": "Filter header range, or null to clear the current auto filter."
          }
        }
      }
    }
  },
  "runtime": "javascript",
  "entry": "tools/propose_patch.js",
  "readonly": false,
  "permissions": {},
  "timeoutMs": 60000,
  "maxOutputBytes": 300000,
  "ui": {
    "card": {
      "kind": "appDefined",
      "family": "excel-live",
      "template": "compact",
      "displayMode": "compact",
      "resultDisplayType": "detailed",
      "primaryColor": "var(--ds-tool-family-agent-component-fg)",
      "displayName": "Propose Workbook Change",
      "icon": "Table",
      "title": "Propose Workbook Change",
      "summary": {
        "preparing": "Preparing workbook proposal",
        "running": "Designing changes for {{input.workbookId}}",
        "completed": "Proposal ready - review on the grid",
        "failed": "Proposal failed"
      },
      "fields": [
        { "label": "Workbook", "inputPath": ["workbookId"] },
        { "label": "Sheet", "inputPath": ["sheetId"] },
        { "label": "Range", "inputPath": ["a1"] },
        { "label": "Revision", "inputPath": ["expectedRevision"] },
        { "label": "Intent", "inputPath": ["intent"] },
        { "label": "Action", "resultPath": ["bridge", "action"] },
        { "label": "Status", "resultPath": ["bridge", "status"] },
        { "label": "Base revision", "resultPath": ["bridge", "output", "proposal", "baseRevision"] },
        { "label": "Validation", "resultPath": ["bridge", "output", "proposal", "validation"], "format": "json" },
        { "label": "Layout", "resultPath": ["bridge", "output", "proposal", "layout"], "format": "json" },
        { "label": "Output", "resultPath": ["bridge", "output"], "format": "json" }
      ]
    }
  }
}
