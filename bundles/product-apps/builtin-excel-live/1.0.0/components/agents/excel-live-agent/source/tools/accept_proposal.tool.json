{
  "name": "accept_proposal",
  "description": "Apply all or a reviewed subset of the active proposal to committed cells. Unaccepted cells remain as a rebased proposal. Call this only when the user explicitly asks you to Accept from chat.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "workbookId",
      "proposalId",
      "expectedRevision"
    ],
    "properties": {
      "workbookId": {
        "type": "string"
      },
      "proposalId": {
        "type": "string",
        "description": "Active proposal id shown by get_proposal or the grid."
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Current workbook revision that was reviewed with the proposal."
      },
      "cellRefs": {
        "type": "array",
        "description": "Optional reviewed subset to accept, expressed as A1 refs. Omit to accept the entire proposal.",
        "items": { "type": "string" },
        "minItems": 1,
        "uniqueItems": true
      }
    }
  },
  "runtime": "javascript",
  "entry": "tools/accept_proposal.js",
  "readonly": false,
  "permissions": {},
  "timeoutMs": 30000,
  "maxOutputBytes": 60000,
  "ui": {
    "card": {
      "kind": "appDefined",
      "family": "excel-live",
      "template": "compact",
      "displayMode": "compact",
      "resultDisplayType": "detailed",
      "primaryColor": "var(--ds-tool-family-agent-component-fg)",
      "displayName": "Accept Proposal",
      "icon": "Check",
      "title": "Accept Proposal",
      "summary": {
        "preparing": "Preparing accept",
        "running": "Accepting proposal",
        "completed": "Proposal accepted on the grid",
        "failed": "Accept failed"
      },
      "fields": [
        {
          "label": "Workbook",
          "inputPath": [
            "workbookId"
          ]
        },
        {
          "label": "Proposal",
          "inputPath": [
            "proposalId"
          ]
        },
        {
          "label": "Revision",
          "inputPath": [
            "expectedRevision"
          ]
        },
        {
          "label": "Status",
          "resultPath": [
            "bridge",
            "status"
          ]
        },
        {
          "label": "Output",
          "resultPath": [
            "bridge",
            "output"
          ],
          "format": "json"
        }
      ]
    }
  }
}
