{
  "name": "switch_sheet",
  "description": "Switch the active sheet by id or name and update ambient focus to that sheet.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "workbookId"
    ],
    "anyOf": [
      { "required": ["sheetId"] },
      { "required": ["sheetName"] }
    ],
    "properties": {
      "workbookId": {
        "type": "string"
      },
      "sheetId": {
        "type": "string"
      },
      "sheetName": {
        "type": "string"
      }
    }
  },
  "runtime": "javascript",
  "entry": "tools/switch_sheet.js",
  "readonly": false,
  "permissions": {},
  "timeoutMs": 30000,
  "maxOutputBytes": 60000,
  "ui": {
    "card": {
      "kind": "appDefined",
      "family": "excel-live",
      "template": "compact",
      "displayMode": "compact",
      "resultDisplayType": "detailed",
      "primaryColor": "var(--ds-tool-family-agent-component-fg)",
      "displayName": "Switch Sheet",
      "icon": "Layers",
      "title": "Switch Sheet",
      "summary": {
        "preparing": "Switching sheet",
        "running": "Switching sheet",
        "completed": "Sheet switched",
        "failed": "Switch failed"
      },
      "fields": [
        {
          "label": "Workbook",
          "inputPath": [
            "workbookId"
          ]
        },
        {
          "label": "Sheet",
          "inputPath": [
            "sheetId"
          ]
        },
        {
          "label": "Name",
          "inputPath": [
            "sheetName"
          ]
        },
        {
          "label": "Output",
          "resultPath": [
            "bridge",
            "output"
          ],
          "format": "json"
        }
      ]
    }
  }
}
