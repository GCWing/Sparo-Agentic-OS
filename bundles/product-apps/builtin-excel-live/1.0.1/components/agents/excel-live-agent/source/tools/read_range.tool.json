{
  "name": "read_range",
  "description": "Read grounded cell values, formulas, cell styles, calculation status, and sheet layout for a range. Defaults to ambient focus when a1 is omitted and enforces maxCells (default 2000). Use before reasoning about or redesigning content.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "workbookId"
    ],
    "properties": {
      "workbookId": {
        "type": "string"
      },
      "sheetId": {
        "type": "string"
      },
      "a1": {
        "type": "string"
      },
      "maxCells": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20000
      }
    }
  },
  "runtime": "javascript",
  "entry": "tools/read_range.js",
  "readonly": true,
  "permissions": {},
  "timeoutMs": 30000,
  "maxOutputBytes": 200000,
  "ui": {
    "card": {
      "kind": "appDefined",
      "family": "excel-live",
      "template": "compact",
      "displayMode": "compact",
      "resultDisplayType": "detailed",
      "primaryColor": "var(--ds-tool-family-agent-component-fg)",
      "displayName": "Read Range",
      "icon": "Table",
      "title": "Read Range",
      "summary": {
        "preparing": "Preparing read",
        "running": "Reading {{input.a1}}",
        "completed": "Range read",
        "failed": "Read failed"
      },
      "fields": [
        {
          "label": "Workbook",
          "inputPath": [
            "workbookId"
          ]
        },
        {
          "label": "Sheet",
          "inputPath": [
            "sheetId"
          ]
        },
        {
          "label": "Range",
          "inputPath": [
            "a1"
          ]
        },
        {
          "label": "Output",
          "resultPath": [
            "bridge",
            "output"
          ],
          "format": "json"
        }
      ]
    }
  }
}
