{
  "name": "undo_workbook",
  "description": "Undo the latest committed Excel Live operation. Use only when the user explicitly asks to reverse a committed change.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["workbookId", "expectedRevision"],
    "properties": {
      "workbookId": { "type": "string" },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Current workbook revision from spreadsheet focus or get_workbook_meta."
      }
    }
  },
  "runtime": "javascript",
  "entry": "tools/undo_workbook.js",
  "readonly": false,
  "permissions": {},
  "timeoutMs": 30000,
  "maxOutputBytes": 60000,
  "ui": {
    "card": {
      "kind": "appDefined",
      "family": "excel-live",
      "template": "compact",
      "displayMode": "compact",
      "resultDisplayType": "detailed",
      "displayName": "Undo Workbook Change",
      "icon": "Undo2",
      "title": "Undo Workbook Change",
      "summary": {
        "preparing": "Checking workbook history",
        "running": "Undoing the latest change",
        "completed": "Workbook change undone",
        "failed": "Undo failed"
      }
    }
  }
}
