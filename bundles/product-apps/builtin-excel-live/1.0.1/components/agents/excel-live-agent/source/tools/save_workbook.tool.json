{
  "name": "save_workbook",
  "description": "Export a source-safe workbook copy. The live revisioned store is already persisted; never overwrite the imported source file.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "workbookId",
      "expectedRevision",
      "path"
    ],
    "properties": {
      "workbookId": {
        "type": "string"
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Exact workbook revision reviewed before export. Refresh metadata if this conflicts."
      },
      "path": {
        "type": "string",
        "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+\\.(?:xlsx|xlsm)$",
        "description": "Required .xlsx or .xlsm copy path relative to the active workspace. Absolute paths, parent traversal, source overwrite, and CSV are not allowed."
      },
      "acknowledgeFidelityLoss": {
        "type": "boolean",
        "description": "Normally false. Set true only after the user has seen the workbook's concrete fidelity warning, explicitly accepted the losses, and chosen a distinct .xlsx Save As path. Never use true for .xlsm."
      }
    }
  },
  "runtime": "javascript",
  "entry": "tools/save_workbook.js",
  "readonly": false,
  "permissions": {},
  "timeoutMs": 60000,
  "maxOutputBytes": 60000,
  "ui": {
    "card": {
      "kind": "appDefined",
      "family": "excel-live",
      "template": "compact",
      "displayMode": "compact",
      "resultDisplayType": "detailed",
      "primaryColor": "var(--ds-tool-family-agent-component-fg)",
      "displayName": "Save Workbook",
      "icon": "Save",
      "title": "Export Workbook",
      "summary": {
        "preparing": "Preparing export",
        "running": "Exporting workbook file",
        "completed": "Workbook file exported",
        "failed": "Export failed"
      },
      "fields": [
        {
          "label": "Workbook",
          "inputPath": [
            "workbookId"
          ]
        },
        {
          "label": "Path",
          "inputPath": [
            "path"
          ]
        },
        {
          "label": "Revision",
          "inputPath": [
            "expectedRevision"
          ]
        },
        {
          "label": "Loss acknowledged",
          "inputPath": [
            "acknowledgeFidelityLoss"
          ]
        },
        {
          "label": "Output",
          "resultPath": [
            "bridge",
            "output"
          ],
          "format": "json"
        }
      ]
    }
  }
}
