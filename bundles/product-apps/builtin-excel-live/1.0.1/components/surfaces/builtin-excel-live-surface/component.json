{
  "id": "builtin-excel-live-surface",
  "kind": "surface",
  "name": "Excel Live Workbench",
  "description": "The app-owned revisioned spreadsheet grid, grounded focus bar, proposal inspector, undo history, and source-safe export surface for Excel Live.",
  "packageSource": "appPrivate",
  "ownerApp": {
    "appId": "builtin-excel-live",
    "appVersion": "1.0.1"
  },
  "capabilities": [
    {
      "id": "interactiveSurface",
      "title": "Interactive surface",
      "description": "Hosts the Excel Live primary spreadsheet workbench.",
      "actions": [
        "open",
        "createWorkbook",
        "saveWorkbook",
        "exportCopy",
        "setFocus",
        "acceptProposal",
        "rejectProposal",
        "undo",
        "redo",
        "applyLocalPatch"
      ]
    }
  ],
  "permissions": [
    {
      "kind": "fs",
      "summary": "Reads and writes workbook files under the workspace via the Excel engine bridge.",
      "scopes": [
        "{workspace}",
        "{appdata}"
      ]
    }
  ],
  "usedByApps": [
    "builtin-excel-live"
  ],
  "visibility": "appDependency",
  "dependencies": [
    {
      "componentId": "excel-live-agent",
      "kind": "agent",
      "source": "private",
      "role": "excelAgent",
      "capabilities": [
        "inspectWorkbook",
        "transformRange",
        "authorWorkbook"
      ]
    },
    {
      "componentId": "builtin-excel-runtime",
      "kind": "bridge",
      "source": "private",
      "role": "excelEngine",
      "capabilities": [
        "sparo.excelEngine"
      ]
    },
    {
      "componentId": "product-app-runtime-host",
      "kind": "runtime",
      "source": "shared",
      "role": "runtimeHost",
      "version": "^1.0.0",
      "capabilities": [
        "uiWorker"
      ]
    }
  ],
  "implementationRef": "app://builtin-excel-live@1.0.1/surfaces/builtin-excel-live-surface",
  "usesCapabilities": [
    "session.read",
    "component.run"
  ]
}
