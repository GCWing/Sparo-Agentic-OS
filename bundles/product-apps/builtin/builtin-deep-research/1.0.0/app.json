{
  "id": "builtin-deep-research",
  "version": "1.0.0",
  "name": "Deep Research",
  "description": "Research app for parallel investigation, synthesis, and comprehensive report creation.",
  "goal": "Investigate a topic deeply, compare evidence, and synthesize a useful report.",
  "interactionModel": "conversation",
  "workMultiplicity": "multiple",
  "workObjectKinds": [
    {
      "id": "research-question",
      "label": "Research Question",
      "scope": "workspace",
      "identitySchema": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          }
        }
      },
      "contextSchema": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string"
          },
          "sources": {
            "type": "array"
          },
          "openQuestions": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "evidence-set",
      "label": "Evidence Set",
      "scope": "asset",
      "identitySchema": {
        "type": "object",
        "properties": {
          "evidenceSetId": {
            "type": "string"
          },
          "artifactId": {
            "type": "string"
          }
        }
      },
      "contextSchema": {
        "type": "object",
        "properties": {
          "claims": {
            "type": "array"
          },
          "citations": {
            "type": "array"
          },
          "confidence": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "research-report",
      "label": "Research Report",
      "scope": "asset",
      "identitySchema": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "contextSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "audience": {
            "type": "string"
          },
          "sections": {
            "type": "array"
          }
        }
      }
    }
  ],
  "primarySurface": {
    "componentId": "builtin-deep-research-chat-surface",
    "surfaceId": "primary"
  },
  "primarySurfaceMode": "chatPrimary",
  "components": [
    {
      "componentId": "builtin-deep-research-chat-surface",
      "kind": "surface",
      "source": "private",
      "role": "primarySurface",
      "capabilities": [
        "chatPrimary"
      ]
    },
    {
      "componentId": "builtin-deep-research-agent",
      "kind": "agent",
      "source": "private",
      "role": "assistant",
      "capabilities": [
        "parallelResearch",
        "synthesizeReport"
      ]
    }
  ],
  "componentLockId": "",
  "permissions": {
    "fs": true,
    "net": true,
    "shell": true,
    "gui": false,
    "secrets": false,
    "ai": true
  },
  "installScope": "system",
  "catalogVisibility": "discoverable",
  "enabled": true,
  "icon": {
    "kind": "packageAsset",
    "path": "assets/icon.svg"
  },
  "category": "analysis",
  "tags": [
    "built-in",
    "research",
    "report"
  ],
  "launch": {
    "kind": "agentSession",
    "targetId": "DeepResearch",
    "scopeRequirement": "workspaceOptional",
    "agentType": "DeepResearch",
    "surfaceId": "primary"
  }
}
