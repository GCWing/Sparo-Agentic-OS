{
  "id": "builtin-ppt-live-surface",
  "kind": "surface",
  "name": "PPT Live Deck Studio",
  "description": "The app-owned deck outline, slide canvas, preview, and export surface.",
  "packageSource": "appPrivate",
  "ownerApp": {
    "appId": "builtin-ppt-live",
    "appVersion": "150.0.2"
  },
  "capabilities": [
    {
      "id": "interactiveSurface",
      "title": "Interactive surface",
      "description": "Hosts the PPT Live primary workspace.",
      "actions": [
        "open",
        "generateDeck",
        "reviseSlide",
        "preview",
        "export"
      ]
    }
  ],
  "permissions": [
    {
      "kind": "fs",
      "summary": "Reads and writes app-owned deck state and export artifacts.",
      "scopes": [
        "{appdata}"
      ]
    },
    {
      "kind": "net",
      "summary": "Fetches user-provided source URLs when generating source-grounded decks.",
      "scopes": [
        "*"
      ]
    }
  ],
  "usedByApps": [
    "builtin-ppt-live"
  ],
  "visibility": "appDependency",
  "dependencies": [
    {
      "componentId": "builtin-ppt-live-agent",
      "kind": "agent",
      "source": "private",
      "role": "ppt",
      "capabilities": [
        "generateDeck",
        "reviseSlide"
      ]
    },
    {
      "componentId": "product-app-runtime-host",
      "kind": "runtime",
      "source": "shared",
      "role": "runtimeHost",
      "version": "^1.0.0",
      "capabilities": [
        "uiWorker"
      ]
    }
  ],
  "implementationRef": "app://builtin-ppt-live@150.0.2/surfaces/builtin-ppt-live-surface",
  "usesCapabilities": [
    "session.read",
    "component.run"
  ]
}
