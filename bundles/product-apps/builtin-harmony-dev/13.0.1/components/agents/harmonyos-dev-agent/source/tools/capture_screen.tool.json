{
  "name": "capture_screen",
  "description": "Capture HarmonyOS screen evidence from the selected emulator or HDC target when the probe is available.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "workspacePath": { "type": "string" },
      "targetId": { "type": "string" },
      "emulatorName": { "type": "string" }
    }
  },
  "runtime": "javascript",
  "entry": "tools/capture_screen.js",
  "readonly": true,
  "permissions": {},
  "timeoutMs": 30000,
  "maxOutputBytes": 24000
}
