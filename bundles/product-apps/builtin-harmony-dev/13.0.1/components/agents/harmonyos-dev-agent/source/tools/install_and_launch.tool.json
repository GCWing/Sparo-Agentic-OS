{
  "name": "install_and_launch",
  "description": "Install the latest HarmonyOS artifact or launch the detected ability on the current HDC target. Pass mode='launch' for the launch step.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "workspacePath": { "type": "string" },
      "mode": { "type": "string", "enum": ["install", "launch"] },
      "targetId": { "type": "string" },
      "artifactPath": { "type": "string" },
      "bundleName": { "type": "string" },
      "abilityName": { "type": "string" }
    }
  },
  "runtime": "javascript",
  "entry": "tools/install_and_launch.js",
  "readonly": false,
  "permissions": {},
  "timeoutMs": 30000,
  "maxOutputBytes": 24000
}
