{
  "id": "builtin-harmony-dev",
  "version": "13.0.1",
  "name": "HarmonyOS Dev",
  "description": "An integrated HarmonyOS app development environment that brings ArkTS, ArkUI, building, packaging, debugging, and device runtime into one workspace.",
  "authors": [
    {
      "name": "Sparo OS",
      "url": "https://gcwing.github.io/Sparo-Agentic-OS/"
    }
  ],
  "i18n": {
    "locales": {
      "en-US": {
        "name": "HarmonyOS Dev",
        "description": "An integrated HarmonyOS app development environment that brings ArkTS, ArkUI, building, packaging, debugging, and device runtime into one workspace.",
        "tags": [
          "built-in",
          "harmonyos",
          "arkui",
          "device",
          "build"
        ]
      },
      "zh-CN": {
        "name": "HarmonyOS Dev",
        "description": "一体化鸿蒙应用开发环境，把 ArkTS、ArkUI、构建、打包、调试和设备运行集中到一个工作空间。",
        "tags": [
          "内置",
          "harmonyos",
          "arkui",
          "设备",
          "构建"
        ]
      }
    }
  },
  "interactionModel": "interactiveWorkspace",
  "workMultiplicity": "multiple",
  "workObjectKinds": [
    {
      "id": "workspace",
      "label": "Workspace",
      "scope": "workspace",
      "identitySchema": {
        "type": "object",
        "required": [
          "workspacePath"
        ],
        "properties": {
          "workspacePath": {
            "type": "string"
          }
        }
      },
      "contextSchema": {
        "type": "object",
        "properties": {
          "projectKind": {
            "type": "string"
          },
          "bundleName": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "ability",
      "label": "Ability",
      "scope": "project",
      "identitySchema": {
        "type": "object",
        "required": [
          "bundleName",
          "abilityName"
        ],
        "properties": {
          "bundleName": {
            "type": "string"
          },
          "abilityName": {
            "type": "string"
          }
        }
      },
      "contextSchema": {
        "type": "object",
        "properties": {
          "entryModule": {
            "type": "string"
          },
          "route": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "build-run",
      "label": "Build Run",
      "scope": "runtime",
      "identitySchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "task": {
            "type": "string"
          }
        }
      },
      "contextSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "artifactPath": {
            "type": "string"
          },
          "diagnostics": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "device-target",
      "label": "Device Target",
      "scope": "device",
      "identitySchema": {
        "type": "object",
        "required": [
          "targetId"
        ],
        "properties": {
          "targetId": {
            "type": "string"
          },
          "targetType": {
            "type": "string"
          }
        }
      },
      "contextSchema": {
        "type": "object",
        "properties": {
          "online": {
            "type": "boolean"
          },
          "apiVersion": {
            "type": "string"
          },
          "emulatorName": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "module",
      "label": "Module",
      "scope": "project",
      "identitySchema": {
        "type": "object",
        "required": [
          "moduleName"
        ],
        "properties": {
          "moduleName": {
            "type": "string"
          },
          "modulePath": {
            "type": "string"
          }
        }
      },
      "contextSchema": {
        "type": "object",
        "properties": {
          "targetSdk": {
            "type": "string"
          },
          "mainElement": {
            "type": "string"
          }
        }
      }
    }
  ],
  "truthSource": "runtimeFact",
  "primarySurface": {
    "componentId": "builtin-harmony-dev-surface",
    "surfaceId": "primary"
  },
  "primarySurfaceMode": "sidecarLinked",
  "components": [
    {
      "componentId": "builtin-harmony-dev-surface",
      "kind": "surface",
      "source": "private",
      "role": "primarySurface",
      "capabilities": [
        "interactiveSurface"
      ],
      "usesCapabilities": [
        "session.read",
        "component.run"
      ]
    },
    {
      "componentId": "harmonyos-dev-agent",
      "kind": "agent",
      "source": "private",
      "role": "assistant",
      "capabilities": [
        "understandHarmonyProject",
        "reviseHarmonyUi",
        "buildInstallVerify",
        "diagnoseHarmonyFailure"
      ],
      "usesCapabilities": [
        "filesystem.read",
        "filesystem.write",
        "terminal.run",
        "process.spawn",
        "workspace.inspect",
        "workspace.modify",
        "session.read",
        "model.invoke",
        "tool.invoke",
        "component.run"
      ]
    },
    {
      "componentId": "builtin-harmony-runtime",
      "kind": "bridge",
      "source": "private",
      "role": "runtime",
      "capabilities": [
        "sparo.harmonyDev"
      ],
      "usesCapabilities": [
        "filesystem.read",
        "filesystem.write",
        "terminal.run",
        "process.spawn",
        "workspace.inspect",
        "component.run"
      ]
    },
    {
      "componentId": "product-app-runtime-host",
      "kind": "runtime",
      "source": "shared",
      "role": "runtimeHost",
      "version": "^1.0.0",
      "capabilities": [
        "uiWorker"
      ],
      "usesCapabilities": [
        "component.run"
      ]
    }
  ],
  "componentLockId": "",
  "permissions": {
    "fs": true,
    "net": false,
    "shell": true,
    "gui": false,
    "secrets": false,
    "ai": true
  },
  "installScope": "system",
  "catalogVisibility": "discoverable",
  "enabled": true,
  "icon": {
    "kind": "packageAsset",
    "path": "assets/icon.png"
  },
  "category": "developer",
  "tags": [
    "built-in",
    "harmonyos",
    "arkui",
    "device",
    "build"
  ],
  "launch": {
    "kind": "applicationSurface",
    "targetId": "builtin-harmony-dev",
    "scopeRequirement": "workspaceRequired",
    "surfaceId": "primary"
  },
  "osCapabilities": [
    "session.read",
    "component.run",
    "filesystem.read",
    "filesystem.write",
    "terminal.run",
    "process.spawn",
    "workspace.inspect",
    "workspace.modify",
    "model.invoke",
    "tool.invoke"
  ],
  "dataLifecycle": {
    "retention": "userManaged",
    "deletion": "deleteOnUserRequest",
    "migration": "schemaVersioned",
    "share": "declaredWorkObjectsOnly"
  }
}
