{
  "id": "builtin-spark-board",
  "version": "1.0.0",
  "name": "Spark Board",
  "description": "A lightweight thinking canvas for capturing inspiration, organizing threads, and turning scattered ideas into drafts and next steps.",
  "authors": [
    {
      "name": "GCWing",
      "url": "https://github.com/GCWing"
    }
  ],
  "i18n": {
    "locales": {
      "en-US": {
        "name": "Spark Board",
        "description": "A lightweight thinking canvas for capturing inspiration, organizing threads, and turning scattered ideas into drafts and next steps.",
        "tags": ["built-in", "canvas", "ideation", "drafting"]
      },
      "zh-CN": {
        "name": "Spark Board",
        "description": "轻量思考画布，用来捕捉灵感、梳理脉络，把零散想法沉淀成草稿和下一步。",
        "tags": ["内置", "画布", "灵感", "草稿"]
      }
    }
  },
  "interactionModel": "interactiveWorkspace",
  "workMultiplicity": "singleton",
  "workObjectKinds": [
    {
      "id": "board",
      "label": "Board",
      "scope": "asset",
      "identitySchema": {
        "type": "object",
        "properties": {
          "boardId": {
            "type": "string"
          },
          "workspacePath": {
            "type": "string"
          }
        }
      },
      "contextSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "clusters": {
            "type": "array"
          },
          "selection": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "idea-card",
      "label": "Idea Card",
      "scope": "asset",
      "identitySchema": {
        "type": "object",
        "properties": {
          "boardId": {
            "type": "string"
          },
          "cardId": {
            "type": "string"
          }
        }
      },
      "contextSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "clusterId": {
            "type": "string"
          },
          "position": {
            "type": "object"
          }
        }
      }
    },
    {
      "id": "draft",
      "label": "Draft",
      "scope": "asset",
      "identitySchema": {
        "type": "object",
        "properties": {
          "draftId": {
            "type": "string"
          },
          "artifactId": {
            "type": "string"
          }
        }
      },
      "contextSchema": {
        "type": "object",
        "properties": {
          "sourceCards": {
            "type": "array"
          },
          "format": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  ],
  "truthSource": "ownedObjectState",
  "primarySurface": {
    "componentId": "builtin-spark-board-surface",
    "surfaceId": "primary"
  },
  "primarySurfaceMode": "immersivePrimary",
  "components": [
    {
      "componentId": "builtin-spark-board-surface",
      "kind": "surface",
      "source": "private",
      "role": "primarySurface",
      "capabilities": [
        "interactiveSurface"
      ],
      "usesCapabilities": [
        "session.read",
        "component.run"
      ]
    },
    {
      "componentId": "builtin-spark-board-agent",
      "kind": "agent",
      "source": "private",
      "role": "assistant",
      "capabilities": [
        "expandIdeas",
        "draftFromSelection"
      ],
      "usesCapabilities": [
        "session.read",
        "model.invoke",
        "tool.invoke"
      ]
    },
    {
      "componentId": "product-app-runtime-host",
      "kind": "runtime",
      "source": "shared",
      "role": "runtimeHost",
      "version": "^1.0.0",
      "capabilities": [
        "uiWorker"
      ],
      "usesCapabilities": [
        "component.run"
      ]
    }
  ],
  "componentLockId": "",
  "permissions": {
    "fs": true,
    "net": false,
    "shell": false,
    "gui": false,
    "secrets": false,
    "ai": true
  },
  "installScope": "system",
  "catalogVisibility": "discoverable",
  "enabled": true,
  "icon": {
    "kind": "packageAsset",
    "path": "assets/icon.png"
  },
  "category": "creative",
  "tags": [
    "built-in",
    "canvas",
    "ideation",
    "drafting"
  ],
  "launch": {
    "kind": "applicationSurface",
    "targetId": "builtin-spark-board",
    "scopeRequirement": "workspaceOptional",
    "surfaceId": "primary"
  },
  "osCapabilities": [
    "session.read",
    "component.run",
    "model.invoke",
    "tool.invoke"
  ]
}
