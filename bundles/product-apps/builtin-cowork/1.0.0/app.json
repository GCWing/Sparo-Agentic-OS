{
  "id": "builtin-cowork",
  "version": "1.0.0",
  "name": "Cowork",
  "description": "An office delivery Agent for documents, spreadsheets, slides, and material organization, turning everyday work into polished output.",
  "authors": [
    {
      "name": "wgqqqqq",
      "url": "https://github.com/wgqqqqq"
    }
  ],
  "i18n": {
    "locales": {
      "en-US": {
        "name": "Cowork",
        "description": "An office delivery Agent for documents, spreadsheets, slides, and material organization, turning everyday work into polished output.",
        "tags": [
          "built-in",
          "office",
          "documents",
          "spreadsheets",
          "slides"
        ]
      },
      "zh-CN": {
        "name": "Cowork",
        "description": "面向办公交付的 Agent，擅长文档、表格、PPT 和资料整理，把日常工作推进成清晰成稿。",
        "tags": [
          "内置",
          "办公",
          "文档",
          "表格",
          "PPT"
        ]
      }
    }
  },
  "interactionModel": "conversation",
  "workMultiplicity": "multiple",
  "workObjectKinds": [
    {
      "id": "office-task",
      "label": "Office Task",
      "scope": "workspace",
      "identitySchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          }
        }
      },
      "contextSchema": {
        "type": "object",
        "properties": {
          "artifactType": {
            "type": "string"
          }
        }
      }
    }
  ],
  "primarySurfaceMode": "chatPrimary",
  "components": [
    {
      "componentId": "builtin-cowork-agent",
      "kind": "agent",
      "source": "private",
      "role": "assistant",
      "capabilities": [
        "office-work",
        "draft"
      ],
      "usesCapabilities": [
        "filesystem.read",
        "filesystem.write",
        "workspace.inspect",
        "workspace.modify",
        "session.read",
        "session.write",
        "memory.read",
        "model.invoke",
        "tool.invoke"
      ]
    }
  ],
  "componentLockId": "",
  "permissions": {
    "fs": true,
    "net": true,
    "shell": true,
    "gui": false,
    "secrets": false,
    "ai": true
  },
  "installScope": "system",
  "catalogVisibility": "discoverable",
  "enabled": true,
  "icon": {
    "kind": "packageAsset",
    "path": "assets/icon.png",
    "mimeType": "image/png"
  },
  "category": "productivity",
  "tags": [
    "built-in",
    "office",
    "documents",
    "spreadsheets",
    "slides"
  ],
  "launch": {
    "kind": "agentSession",
    "targetId": "Cowork",
    "scopeRequirement": "workspaceOptional",
    "agentType": "Cowork"
  },
  "osCapabilities": [
    "filesystem.read",
    "filesystem.write",
    "workspace.inspect",
    "workspace.modify",
    "session.read",
    "session.write",
    "memory.read",
    "model.invoke",
    "tool.invoke"
  ],
  "dataLifecycle": {
    "retention": "userManaged",
    "deletion": "deleteOnUserRequest",
    "migration": "exportImport",
    "share": "declaredWorkObjectsOnly"
  }
}
