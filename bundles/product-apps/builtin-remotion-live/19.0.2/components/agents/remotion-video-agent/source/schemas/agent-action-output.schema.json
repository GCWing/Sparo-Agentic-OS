{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Remotion Agent Action Output",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "summary": { "type": "string" },
    "selectedTarget": { "type": "string" },
    "likelySourceFiles": { "type": "array", "items": { "type": "string" } },
    "changedFiles": { "type": "array", "items": { "type": "string" } },
    "visualHypothesis": { "type": "string" },
    "validationRequest": {
      "type": "object",
      "properties": {
        "compositionId": { "type": "string" },
        "frames": { "type": "array", "items": { "type": "integer" } },
        "mode": { "type": "string", "enum": ["still", "player-refresh"] }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["passed", "failed", "inconclusive"] },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "frame": { "type": "integer" },
              "path": { "type": "string" },
              "uri": { "type": "string" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "userFacingSummary": { "type": "string" },
    "uncertainty": { "type": "string" },
    "nextStep": { "type": "string" }
  }
}
