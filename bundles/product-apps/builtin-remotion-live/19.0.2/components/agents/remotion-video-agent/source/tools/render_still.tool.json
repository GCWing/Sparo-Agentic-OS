{
  "name": "render_still",
  "description": "Render a still image for a Remotion composition frame through the workspace Remotion toolchain.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["compositionId", "frame", "expectedProjectRevision", "expectedDescriptorRevision"],
    "properties": {
      "workspacePath": { "type": "string" },
      "entryPoint": { "type": "string" },
      "compositionId": { "type": "string" },
      "expectedProjectRevision": { "type": "string", "minLength": 1 },
      "expectedDescriptorRevision": { "type": "string", "minLength": 1 },
      "frame": { "type": "integer" },
      "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
      "inputProps": { "type": "object" }
    }
  },
  "runtime": "javascript",
  "entry": "tools/render_still.js",
  "readonly": true,
  "permissions": {},
  "timeoutMs": 300000,
  "maxOutputBytes": 60000
}
