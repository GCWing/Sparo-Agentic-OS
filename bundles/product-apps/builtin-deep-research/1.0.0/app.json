{
  "id": "builtin-deep-research",
  "version": "1.0.0",
  "name": "Deep Research",
  "description": "A deep research Agent for finding sources, comparing viewpoints, organizing evidence, and turning complex questions into clear conclusions.",
  "i18n": {
    "locales": {
      "en-US": {
        "name": "Deep Research",
        "description": "A deep research Agent for finding sources, comparing viewpoints, organizing evidence, and turning complex questions into clear conclusions.",
        "tags": [
          "built-in",
          "research",
          "evidence",
          "report"
        ]
      },
      "zh-CN": {
        "name": "Deep Research",
        "description": "面向深度研究的 Agent，适合查资料、比观点、梳理依据，把复杂问题沉淀为清晰结论。",
        "tags": [
          "内置",
          "研究",
          "证据",
          "报告"
        ]
      }
    }
  },
  "interactionModel": "conversation",
  "workMultiplicity": "multiple",
  "workObjectKinds": [
    {
      "id": "research-question",
      "label": "Research Question",
      "scope": "workspace",
      "identitySchema": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          }
        }
      },
      "contextSchema": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string"
          },
          "sources": {
            "type": "array"
          },
          "openQuestions": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "evidence-set",
      "label": "Evidence Set",
      "scope": "asset",
      "identitySchema": {
        "type": "object",
        "properties": {
          "evidenceSetId": {
            "type": "string"
          },
          "artifactId": {
            "type": "string"
          }
        }
      },
      "contextSchema": {
        "type": "object",
        "properties": {
          "claims": {
            "type": "array"
          },
          "citations": {
            "type": "array"
          },
          "confidence": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "research-report",
      "label": "Research Report",
      "scope": "asset",
      "identitySchema": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "contextSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "audience": {
            "type": "string"
          },
          "sections": {
            "type": "array"
          }
        }
      }
    }
  ],
  "primarySurface": {
    "componentId": "builtin-deep-research-chat-surface",
    "surfaceId": "primary"
  },
  "primarySurfaceMode": "chatPrimary",
  "components": [
    {
      "componentId": "builtin-deep-research-chat-surface",
      "kind": "surface",
      "source": "private",
      "role": "primarySurface",
      "capabilities": [
        "chatPrimary"
      ],
      "usesCapabilities": [
        "session.read",
        "component.run"
      ]
    },
    {
      "componentId": "builtin-deep-research-agent",
      "kind": "agent",
      "source": "private",
      "role": "assistant",
      "capabilities": [
        "parallelResearch",
        "synthesizeReport"
      ],
      "usesCapabilities": [
        "browser.navigate",
        "browser.inspect",
        "session.read",
        "session.write",
        "memory.read",
        "memory.write",
        "model.invoke",
        "tool.invoke"
      ]
    }
  ],
  "componentLockId": "",
  "permissions": {
    "fs": true,
    "net": true,
    "shell": true,
    "gui": false,
    "secrets": false,
    "ai": true
  },
  "installScope": "system",
  "catalogVisibility": "discoverable",
  "enabled": true,
  "icon": {
    "kind": "packageAsset",
    "path": "assets/icon.svg"
  },
  "category": "analysis",
  "tags": [
    "built-in",
    "research",
    "evidence",
    "report"
  ],
  "launch": {
    "kind": "agentSession",
    "targetId": "DeepResearch",
    "scopeRequirement": "workspaceOptional",
    "agentType": "DeepResearch",
    "surfaceId": "primary"
  },
  "osCapabilities": [
    "session.read",
    "component.run",
    "browser.navigate",
    "browser.inspect",
    "session.write",
    "memory.read",
    "memory.write",
    "model.invoke",
    "tool.invoke"
  ],
  "dataLifecycle": {
    "retention": "workRuntimeScoped",
    "deletion": "deleteWithWork",
    "migration": "exportImport",
    "share": "declaredWorkObjectsOnly"
  }
}
