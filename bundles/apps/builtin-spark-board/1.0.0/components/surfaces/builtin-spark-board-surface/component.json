{
  "id": "builtin-spark-board-surface",
  "kind": "surface",
  "name": "Spark Board Canvas",
  "description": "The app-owned idea canvas, clustering, selection, and draft creation surface.",
  "packageSource": "appPrivate",
  "ownerApp": {
    "appId": "builtin-spark-board",
    "appVersion": "1.0.0"
  },
  "capabilities": [
    {
      "id": "interactiveSurface",
      "title": "Interactive surface",
      "description": "Hosts the Spark Board primary workspace.",
      "actions": [
        "open",
        "createCard",
        "clusterIdeas",
        "draftFromSelection"
      ]
    }
  ],
  "permissions": [
    {
      "kind": "fs",
      "summary": "Reads and writes app-owned canvas state.",
      "scopes": [
        "{appdata}"
      ]
    }
  ],
  "usedByApps": [
    "builtin-spark-board"
  ],
  "visibility": "appDependency",
  "dependencies": [
    {
      "componentId": "builtin-spark-board-agent",
      "kind": "agent",
      "source": "private",
      "role": "assistant",
      "capabilities": [
        "expandIdeas",
        "draftFromSelection"
      ]
    },
    {
      "componentId": "surface-component-runtime",
      "kind": "runtime",
      "source": "shared",
      "role": "runtimeHost",
      "version": "^1.0.0",
      "capabilities": [
        "uiWorker"
      ]
    }
  ],
  "implementationRef": "bundle://surface-components/spark-board"
}
