{
  "id": "builtin-spark-board",
  "version": "1.0.0",
  "name": "Spark Board",
  "description": "Collaborative AI canvas for creative thinking, clustering ideas, and turning selected notes into ready drafts.",
  "goal": "Capture rough ideas, organize them on a canvas, and transform selected notes into useful drafts.",
  "interactionModel": "interactiveWorkspace",
  "workMultiplicity": "singleton",
  "workObjectKinds": [],
  "truthSource": "ownedObjectState",
  "primarySurface": {
    "componentId": "builtin-spark-board-surface",
    "surfaceId": "primary"
  },
  "primarySurfaceMode": "sidecarLinked",
  "components": [
    {
      "componentId": "builtin-spark-board-surface",
      "kind": "surface",
      "source": "private",
      "role": "primarySurface",
      "capabilities": [
        "interactiveSurface"
      ]
    },
    {
      "componentId": "builtin-spark-board-agent",
      "kind": "agent",
      "source": "private",
      "role": "assistant",
      "capabilities": [
        "expandIdeas",
        "draftFromSelection"
      ]
    },
    {
      "componentId": "surface-component-runtime",
      "kind": "runtime",
      "source": "shared",
      "role": "runtimeHost",
      "version": "^1.0.0",
      "capabilities": [
        "uiWorker"
      ]
    }
  ],
  "componentLockId": "",
  "permissions": {
    "fs": true,
    "net": false,
    "shell": false,
    "gui": false,
    "secrets": false,
    "ai": true
  },
  "installScope": "system",
  "catalogVisibility": "discoverable",
  "enabled": true,
  "icon": "Sparkles",
  "category": "creative",
  "tags": [
    "built-in",
    "canvas",
    "creative",
    "ai"
  ],
  "launch": {
    "kind": "applicationSurface",
    "targetId": "builtin-spark-board",
    "scopeRequirement": "workspaceOptional",
    "surfaceId": "primary"
  }
}
