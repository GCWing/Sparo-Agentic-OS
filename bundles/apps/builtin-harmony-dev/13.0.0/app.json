{
  "id": "builtin-harmony-dev",
  "version": "13.0.0",
  "name": "HarmonyOS Dev",
  "description": "A device-fact-centered collaborative workbench for HarmonyOS app development.",
  "goal": "Collaboratively develop, build, install, run, and diagnose a HarmonyOS application.",
  "interactionModel": "interactiveWorkspace",
  "workObjectKinds": [],
  "truthSource": "runtimeFact",
  "primarySurface": {
    "componentId": "builtin-harmony-dev-surface",
    "surfaceId": "primary"
  },
  "primarySurfaceMode": "sidecarLinked",
  "components": [
    {
      "componentId": "builtin-harmony-dev-surface",
      "kind": "surface",
      "source": "private",
      "role": "primarySurface",
      "capabilities": [
        "interactiveSurface"
      ]
    },
    {
      "componentId": "harmonyos-dev-agent",
      "kind": "agent",
      "source": "shared",
      "role": "assistant",
      "version": "^1.0.0",
      "capabilities": [
        "understandHarmonyProject",
        "reviseHarmonyUi",
        "buildInstallVerify",
        "diagnoseHarmonyFailure"
      ]
    },
    {
      "componentId": "builtin-harmony-runtime",
      "kind": "bridge",
      "source": "shared",
      "role": "runtime",
      "version": "^1.0.0",
      "capabilities": [
        "sparo.harmonyDev"
      ]
    },
    {
      "componentId": "surface-component-runtime",
      "kind": "runtime",
      "source": "shared",
      "role": "runtimeHost",
      "version": "^1.0.0",
      "capabilities": [
        "uiWorker"
      ]
    }
  ],
  "componentLockId": "",
  "permissions": {
    "fs": true,
    "net": false,
    "shell": true,
    "gui": false,
    "secrets": false,
    "ai": true
  },
  "installScope": "system",
  "catalogVisibility": "discoverable",
  "enabled": true,
  "icon": "Smartphone",
  "category": "developer",
  "tags": [
    "built-in",
    "harmonyos",
    "arkui",
    "arkts",
    "device",
    "preview"
  ],
  "launch": {
    "kind": "applicationSurface",
    "targetId": "builtin-harmony-dev",
    "scopeRequirement": "workspaceRequired",
    "surfaceId": "primary"
  }
}
