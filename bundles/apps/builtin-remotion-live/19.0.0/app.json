{
  "id": "builtin-remotion-live",
  "version": "19.0.0",
  "name": "Remotion Live",
  "description": "A native Sparo video preview workbench for Remotion projects with app-owned playback, timeline, and export controls.",
  "goal": "Collaborate on a Remotion video project from project detection through preview, revision, still rendering, and export.",
  "interactionModel": "interactiveWorkspace",
  "workObjectKinds": [],
  "truthSource": "runtimeFact",
  "primarySurface": {
    "componentId": "builtin-remotion-live-surface",
    "surfaceId": "primary"
  },
  "primarySurfaceMode": "sidecarLinked",
  "components": [
    {
      "componentId": "builtin-remotion-live-surface",
      "kind": "surface",
      "source": "private",
      "role": "primarySurface",
      "capabilities": [
        "interactiveSurface"
      ]
    },
    {
      "componentId": "remotion-video-agent",
      "kind": "agent",
      "source": "shared",
      "role": "assistant",
      "version": "^1.0.0",
      "capabilities": [
        "understandVideoProject",
        "reviseVideoComposition",
        "renderReviewArtifact"
      ]
    },
    {
      "componentId": "builtin-remotion-runtime",
      "kind": "bridge",
      "source": "shared",
      "role": "runtime",
      "version": "^1.0.0",
      "capabilities": [
        "sparo.videoEngine"
      ]
    },
    {
      "componentId": "surface-component-runtime",
      "kind": "runtime",
      "source": "shared",
      "role": "runtimeHost",
      "version": "^1.0.0",
      "capabilities": [
        "uiWorker"
      ]
    }
  ],
  "componentLockId": "",
  "permissions": {
    "fs": true,
    "net": true,
    "shell": true,
    "gui": false,
    "secrets": false,
    "ai": true
  },
  "installScope": "system",
  "catalogVisibility": "discoverable",
  "enabled": true,
  "icon": "Film",
  "category": "creative",
  "tags": [
    "built-in",
    "remotion",
    "video",
    "preview"
  ],
  "launch": {
    "kind": "applicationSurface",
    "targetId": "builtin-remotion-live",
    "scopeRequirement": "workspaceRequired",
    "surfaceId": "primary"
  }
}
