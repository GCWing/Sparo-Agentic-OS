{
  "id": "builtin-component-studio",
  "version": "1.0.0",
  "name": "Component Studio",
  "description": "Studio for creating reusable Surface, Agent, Bridge, Runtime, Tool, and Skill component packages.",
  "goal": "Create and maintain reusable Component Packages that Product Apps can reference.",
  "interactionModel": "conversation",
  "workObjectKinds": [],
  "primarySurface": {
    "componentId": "builtin-component-studio-chat-surface",
    "surfaceId": "primary"
  },
  "primarySurfaceMode": "chatPrimary",
  "components": [
    {
      "componentId": "builtin-component-studio-chat-surface",
      "kind": "surface",
      "source": "private",
      "role": "primarySurface",
      "capabilities": [
        "chatPrimary"
      ]
    },
    {
      "componentId": "builtin-component-studio-agent",
      "kind": "agent",
      "source": "private",
      "role": "assistant",
      "capabilities": [
        "createComponentPackage",
        "validateComponent"
      ]
    }
  ],
  "componentLockId": "",
  "permissions": {
    "fs": true,
    "net": false,
    "shell": false,
    "gui": false,
    "secrets": false,
    "ai": true
  },
  "installScope": "system",
  "catalogVisibility": "discoverable",
  "enabled": true,
  "icon": "Package",
  "category": "developer",
  "tags": [
    "built-in",
    "studio",
    "components"
  ],
  "launch": {
    "kind": "componentStudio",
    "targetId": "ComponentStudio",
    "scopeRequirement": "systemAllowed",
    "agentType": "ComponentStudio",
    "surfaceId": "primary"
  }
}
