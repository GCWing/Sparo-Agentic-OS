{
  "schemaVersion": 1,
  "id": "cursor-sdk",
  "name": "Cursor SDK",
  "description": "Run Cursor SDK agents from Sparo OS against a local workspace or Cursor Cloud repository.",
  "kind": "sdk",
  "runtime": {
    "language": "javascript",
    "entry": "worker.js"
  },
  "surfaces": {
    "launchableApp": false,
    "agent": true,
    "tool": true,
    "productAppRuntimeBackend": true
  },
  "permissions": {
    "fs": ["{workspace}", "{app}"],
    "net": ["https://api.cursor.com", "https://github.com"],
    "shell": ["node", "git", "npm"],
    "gui": [],
    "secrets": ["CURSOR_API_KEY"]
  },
  "capabilities": [
    {
      "id": "cursor.agent",
      "title": "Cursor Agent",
      "description": "Start, observe, resume, cancel, and collect artifacts from Cursor SDK agent runs.",
      "category": "externalAgent",
      "actions": ["health", "setup", "start", "status", "resume", "cancel", "artifacts"],
      "streaming": true,
      "cancelable": true,
      "resumable": true,
      "usableBy": ["agentComponent", "productAppRuntime", "management"],
      "inputSchema": { "type": "object" },
      "outputSchema": { "type": "object" }
    }
  ],
  "actions": [
    {
      "name": "health",
      "description": "Check Node.js, Cursor SDK dependency, git repository, and Cursor API key readiness.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "apiKey": { "type": "string" },
          "validateApiKey": { "type": "boolean" },
          "autoInstallDependencies": { "type": "boolean" }
        }
      },
      "outputSchema": { "type": "object" },
      "streaming": false,
      "cancelable": false,
      "resumable": false
    },
    {
      "name": "setup",
      "description": "Install Cursor SDK dependencies and validate runtime readiness.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "apiKey": { "type": "string" },
          "autoInstallDependencies": { "type": "boolean" }
        }
      },
      "outputSchema": { "type": "object" },
      "streaming": false,
      "cancelable": false,
      "resumable": false
    },
    {
      "name": "start",
      "description": "Create a Cursor SDK agent run. Use mode local or cloud.",
      "inputSchema": {
        "type": "object",
        "required": ["prompt"],
        "properties": {
          "prompt": { "type": "string" },
          "mode": { "type": "string", "enum": ["local", "cloud"] },
          "apiKey": { "type": "string" },
          "model": { "type": "string" },
          "agentName": { "type": "string" },
          "force": { "type": "boolean" },
          "autoInstallDependencies": { "type": "boolean" }
        }
      },
      "outputSchema": { "type": "object" },
      "streaming": true,
      "cancelable": true,
      "resumable": true
    },
    {
      "name": "status",
      "description": "Return the latest known status for a Cursor SDK run.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": { "type": "string" }
        }
      },
      "outputSchema": { "type": "object" },
      "streaming": false,
      "cancelable": false,
      "resumable": false
    },
    {
      "name": "resume",
      "description": "Resume or re-observe a Cursor SDK run when the SDK exposes a resumable reference.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": { "type": "string" }
        }
      },
      "outputSchema": { "type": "object" },
      "streaming": false,
      "cancelable": false,
      "resumable": true
    },
    {
      "name": "cancel",
      "description": "Cancel a Cursor SDK run when a cancellable external reference is available.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": { "type": "string" }
        }
      },
      "outputSchema": { "type": "object" },
      "streaming": false,
      "cancelable": false,
      "resumable": false
    },
    {
      "name": "artifacts",
      "description": "Return Cursor run artifacts such as branch, pull request URL, and external run references.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": { "type": "string" }
        }
      },
      "outputSchema": { "type": "object" },
      "streaming": false,
      "cancelable": false,
      "resumable": false
    }
  ],
  "tools": [
    {
      "name": "CursorAgent",
      "description": "High-level Cursor Agent wrapper backed by this cursor-sdk Bridge Component capability.",
      "capabilityId": "cursor.agent",
      "action": "start",
      "actions": ["health", "setup", "start", "status", "resume", "cancel", "artifacts"],
      "readonly": false,
      "needsPermissions": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["health", "setup", "start", "status", "resume", "cancel", "artifacts"],
            "description": "Bridge lifecycle action. Use health before start when setup, credentials, permissions, or dependencies may be missing."
          },
          "prompt": { "type": "string" },
          "mode": { "type": "string", "enum": ["local", "cloud"] },
          "runId": { "type": "string" },
          "repositoryUrl": { "type": "string" },
          "startingRef": { "type": "string" },
          "model": { "type": "string" },
          "force": { "type": "boolean" },
          "autoCreatePR": { "type": "boolean" },
          "autoInstallDependencies": { "type": "boolean" },
          "validateApiKey": { "type": "boolean" },
          "dryRun": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "ui": {
        "card": {
          "kind": "appDefined",
          "displayName": "Cursor Agent",
          "icon": "CA",
          "resultDisplayType": "detailed",
          "displayMode": "compact",
          "primaryColor": "var(--ds-tool-family-agent-component-fg)",
          "family": "bridge-component",
          "title": "Cursor Agent",
          "summary": {
            "preparing": "Preparing Cursor Agent",
            "running": "Running Cursor Agent",
            "completed": "Cursor Agent completed",
            "failed": "Cursor Agent failed"
          },
          "fields": [
            { "label": "Action", "path": ["action"] },
            { "label": "Mode", "inputPath": ["mode"] },
            { "label": "Run ID", "path": ["run_id"], "inputPath": ["runId"] },
            { "label": "Status", "path": ["status"] },
            { "label": "Output", "path": ["output"], "format": "json" },
            { "label": "stderr", "path": ["stderr"] }
          ]
        }
      }
    }
  ]
}
